      "updated": 1787659547372,
      "link": null,
      "locked": false,
      "text": "As soon as the vendor bill is confirmed a journal entry would be created that would become visible in the Journal Entries section\nFor Vendor bill always purchase chart of account would be set by default\nThe Journal Entry should always be balanced \nThat is the debit and credit totals need to match",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "As soon as the vendor bill is confirmed a journal entry would be created that would become visible in the Journal Entries section\nFor Vendor bill always purchase chart of account would be set by default\nThe Journal Entry should always be balanced \nThat is the debit and credit totals need to match",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
