      "boundElements": [],
      "updated": 1787659534754,
      "link": null,
      "locked": false,
      "text": "On Clicking Revise - New Budget will appear and Old \none will move to Revised state. Link will be visible on\nMain Budget and on click it will lead to new revised \nBudget and the revised will have link to original.",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "On Clicking Revise - New Budget will appear and Old \none will move to Revised state. Link will be visible on\nMain Budget and on click it will lead to new revised \nBudget and the revised will have link to original.",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
