    {
      "id": "hzJi25kvF7rTKgbNyzV7j",
      "type": "text",
      "x": 1644.1785714285713,
      "y": -183.64285714285734,
      "width": 696.4393310546875,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "az",
      "roundness": null,
      "seed": 755299262,
      "version": 469,
      "versionNonce": 1268832867,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1787659504019,
      "link": null,
      "locked": false,
      "text": "For create user page check creds as follows\n1. Login Id should be unique and must be between 6-12 characters\n2. Email should not be a duplicate in database\n3. Password must be unique and must contain a small case, a large case\nand a special character and must have more than 8 characters\n",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For create user page check creds as follows\n1. Login Id should be unique and must be between 6-12 characters\n2. Email should not be a duplicate in database\n3. Password must be unique and must contain a small case, a large case\nand a special character and must have more than 8 characters\n",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "Zyvn7RMDLz2XIfNYramNQ",
      "type": "text",
      "x": 1623.1785714285713,
      "y": 108.85714285714266,
      "width": 976.9990234375,
      "height": 150,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "b00",
      "roundness": null,
      "seed": 398777854,
      "version": 335,
      "versionNonce": 83480694,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1788433121012,
      "link": null,
      "locked": false,
      "text": "Role \nAdmin - Have all access rights\nUser - can only see his invoices/bills in paid/unpaid status and can directly pay his dues from portal\nAccountant - Create Master data, record Transactions and View reports.\n                Can manage customers/vendors, access accounting dashboard, create journal entries, \n                Can create and manage invoices, bills, and payments ",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Role \nAdmin - Have all access rights\nUser - can only see his invoices/bills in paid/unpaid status and can directly pay his dues from portal\nAccountant - Create Master data, record Transactions and View reports.\n                Can manage customers/vendors, access accounting dashboard, create journal entries, \n                Can create and manage invoices, bills, and payments ",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
      "id": "OudRd0bhGZJVnCZ6-1k_s",
