      "updated": 1787659534754,
      "link": null,
      "locked": false,
      "text": "Here User can revise the new confirmed budget e.g. \nBudgeted Expense was 2,00,000\nnow you need to change the limit to 3,50,000",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Here User can revise the new confirmed budget e.g. \nBudgeted Expense was 2,00,000\nnow you need to change the limit to 3,50,000",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
    },
    {
