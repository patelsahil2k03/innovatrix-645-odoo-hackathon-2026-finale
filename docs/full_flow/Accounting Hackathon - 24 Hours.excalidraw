      "seed": 1244861438,
      "version": 115,
      "versionNonce": 33211390,
      "isDeleted": true,
      "boundElements": [],
      "updated": 1784197667515,
      "link": null,
      "locked": false,
      "text": "For Sign up Page,\nCreate a 'invoicing user' database into the system on signup",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "For Sign up Page,\nCreate a 'invoicing user' database into the system on signup",
      "autoResize": true,
      "lineHeight": 1.25,
      "labelPosition": null
