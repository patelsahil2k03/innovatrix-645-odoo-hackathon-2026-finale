# Copy to .env  (scripts/dev.sh does this automatically on first run)

# ── Database ────────────────────────────────────────────────────────────────
# SQLite (default): zero setup, no Docker, one file. Best unless the problem
# statement genuinely needs Postgres features.
DATABASE_URL=sqlite:///./app.db
# PostgreSQL: needs `./scripts/dev.sh --db docker` and `uv sync --extra postgres`
# DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-for-anything-that-leaves-localhost
JWT_EXPIRES_MINUTES=1440
AUTH_COOKIE_SECURE=false          # true requires HTTPS

# ── Demo data ───────────────────────────────────────────────────────────────
SEED_PASSWORD=Demo@1234

# ── Live data simulator (the "dynamic data, not static JSON" proof) ─────────
SIMULATOR_ENABLED=false           # set true for demos/recording
SIMULATOR_INTERVAL_SECONDS=4

# ── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
