# Copy to .env  (scripts/dev.sh does this automatically on first run)

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL (default here): needs `./scripts/dev.sh --db docker` and
# `uv sync --extra postgres`. Required for anything shared or graded — the
# posting engine's row locking (SELECT ... FOR UPDATE) is silently a no-op on
# SQLite. See docs/01_STACK.md §3.1 for the tested reason, and
# docs/08_RUNBOOK.md "Shared team database" to connect to a teammate's instance
# instead of running your own (swap `localhost` for their LAN IP).
DATABASE_URL=postgresql+psycopg://app:app@localhost:5432/app

# SQLite: zero setup, no Docker, one file. Fine for solo local work only —
# never for the shared instance or anything being demoed to the team.
# DATABASE_URL=sqlite:///./app.db

# Only used by infra/docker-compose.yml — the port Postgres/Adminer publish on
# THIS machine. Change only if 5432/8081 are already taken locally.
POSTGRES_PORT=5432
ADMINER_PORT=8081

# ── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-for-anything-that-leaves-localhost
JWT_EXPIRES_MINUTES=1440
AUTH_COOKIE_SECURE=false          # true requires HTTPS

# ── Demo data ───────────────────────────────────────────────────────────────
SEED_PASSWORD=Demo@1234

# ── Live data simulator (the "dynamic data, not static JSON" proof) ─────────
SIMULATOR_ENABLED=false           # set true for demos/recording
SIMULATOR_INTERVAL_SECONDS=4

# ── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
