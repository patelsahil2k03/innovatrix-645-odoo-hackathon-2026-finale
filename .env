# Copy to .env  (scripts/dev.sh does this automatically on first run)
# This file is real, per-machine config — never committed (.gitignore).

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL — the shared team instance. Real credentials, not the "app"/"app"
# default: this is reachable by anyone on the same LAN/hotspot (docs/08_RUNBOOK.md §2).
POSTGRES_USER=app
POSTGRES_PASSWORD=x2gTDGR5LvCEeSw9zGVBTS
POSTGRES_DB=app
DATABASE_URL=postgresql+psycopg://app:x2gTDGR5LvCEeSw9zGVBTS@localhost:5432/app
# Dev team: use this line instead of the one above — comment out the localhost
# line and uncomment this one. Same database, same credentials, reached over
# the LAN/hotspot instead of loopback. If it doesn't connect, see
# docs/08_RUNBOOK.md §2.3 (test the connection) and §2.4 (the hotspot fallback)
# before assuming something's wrong with the database itself.
# DATABASE_URL=postgresql+psycopg://app:x2gTDGR5LvCEeSw9zGVBTS@192.168.10.249:5432/app

# SQLite: zero setup, no Docker. Fine for solo local work only — never for the
# shared instance. DATABASE_URL=sqlite:///./app.db

# ── Auth ────────────────────────────────────────────────────────────────────
# A real random secret, not the placeholder — generated with: openssl rand -hex 32
JWT_SECRET=db82a94b073446cbe7a03d1fac10236816105efc52116d8ba9b85775476d57b4
JWT_EXPIRES_MINUTES=1440
AUTH_COOKIE_SECURE=false          # true requires HTTPS — correct to leave false on plain HTTP/LAN

# ── Demo data ───────────────────────────────────────────────────────────────
SEED_PASSWORD=Demo@1234

# ── Live data simulator (the "dynamic data, not static JSON" proof) ─────────
SIMULATOR_ENABLED=false           # set true for demos/recording
SIMULATOR_INTERVAL_SECONDS=4

# ── Frontend ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
